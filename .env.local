# Local-first Companion Data Platform configuration.
# Copy or pass with: docker compose --env-file .env.local -f docker/docker-compose.yml up -d --build
COMPOSE_PROJECT_NAME=companion_local

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_ENDPOINT_URL=http://minio:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow
DATABASE_URL=postgresql+psycopg2://airflow:airflow@postgres:5432/airflow

KAFKA_BOOTSTRAP_SERVERS=kafka:9092
EVENT_INTERVAL_SECONDS=2
CLICKHOUSE_URL=http://clickhouse:8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=clickhouse

AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW__WEBSERVER__SECRET_KEY=local-companion-secret-key
COMPANION_API_URL=http://api:8000/api/events/export
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SLACK_WEBHOOK_URL=

GF_SECURITY_ADMIN_PASSWORD=admin
CUBEJS_API_SECRET=secret
