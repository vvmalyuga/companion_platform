# Companion platform local/production configuration
COMPOSE_PROJECT_NAME=companion_platform

# MinIO / S3-compatible lakehouse
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_ENDPOINT_URL=http://minio:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# PostgreSQL
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow
DATABASE_URL=postgresql+psycopg2://airflow:airflow@postgres:5432/airflow

# Kafka / streaming
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
EVENT_INTERVAL_SECONDS=2
CLICKHOUSE_URL=http://clickhouse:8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=clickhouse

# Airflow
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW__WEBSERVER__SECRET_KEY=change-me-in-production
COMPANION_API_URL=http://api:8000/api/events/export
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SLACK_WEBHOOK_URL=

# Grafana / Cube.js
GF_SECURITY_ADMIN_PASSWORD=admin
CUBEJS_API_SECRET=secret
API_BASE=http://localhost:8000/api
